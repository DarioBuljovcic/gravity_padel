NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — use onboarding sender until padelgravity.rs is verified:
# MAIL_FROM="Padel Gravity <beth.t@example.com>"
# After DNS (SPF/DKIM): MAIL_FROM="Padel Gravity <rezervacije@padelgravity.rs>"
RESEND_API_KEY=
MAIL_FROM="Padel Gravity <beth.t@example.com>"
ADMIN_NOTIFY_EMAIL=you@example.com
CRON_SECRET=replace-with-a-long-random-string
